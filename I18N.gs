function DUALTranI18NTable(locale) {
  var key = String(locale || "").replace(/-/g, "_");
  if (Object.prototype.hasOwnProperty.call(DUALTRAN_I18N, key)) return key;
  var base = key.split("_")[0];
  if (base === "zh") return "zh_CN";
  if (base === "pt") return "pt_PT";
  if (Object.prototype.hasOwnProperty.call(DUALTRAN_I18N, base)) return base;
  if (Object.prototype.hasOwnProperty.call(DUALTRAN_I18N_ACCOUNT_MAP, base)) {
    return DUALTRAN_I18N_ACCOUNT_MAP[base];
  }
  return "en";
}

/** `t(locale, key)`: the locale's string, falling back to English, then to the key itself. */
function t(locale, key) {
  var table = DUALTRAN_I18N[DUALTranI18NTable(locale)] || {};
  var value = table[key];
  if (typeof value === "string" && value.trim()) return value;
  var fallback = DUALTRAN_I18N.en[key];
  return typeof fallback === "string" && fallback.trim() ? fallback : String(key);
}

/** The whole panel (or the given keys) resolved for one locale, ready to ship to the sidebar. */
function DUALTranI18NPanel(locale, keys) {
  var wanted = keys && keys.length ? keys : Object.keys(DUALTRAN_I18N.en);
  var panel = {};
  for (var i = 0; i < wanted.length; i += 1) panel[wanted[i]] = t(locale, wanted[i]);
  return panel;
}

/** `{NAME}` substitution; unknown placeholders are left in place so a gap is visible. */
function DUALTranI18NFill(template, values) {
  return String(template || "").replace(/\{([A-Z][A-Z0-9_]*)\}/g, function (match, name) {
    if (!values || !Object.prototype.hasOwnProperty.call(values, name)) return match;
    return String(values[name]);
  });
}

/** Convenience for Code.gs: the matrix key for the active account locale. */
function DUALTranI18NLocale(locale) {
  return DUALTranI18NTable(locale);
}

if (typeof module !== "undefined" && module.exports) {
  module.exports = {
    DUALTRAN_I18N: DUALTRAN_I18N,
    DUALTRAN_I18N_LOCALES: DUALTRAN_I18N_LOCALES,
    DUALTranI18NTable: DUALTranI18NTable,
    t: t,
    DUALTranI18NPanel: DUALTranI18NPanel,
    DUALTranI18NFill: DUALTranI18NFill,
  };
}
