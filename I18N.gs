/**
 * Google account locale -> matrix key. Region is ignored for languages we ship one variant
 * of; only Portuguese and Chinese split, and both fall back to their main variant.
 */
var DUALTRAN_I18N_ACCOUNT_MAP = {
  af: "en",
  am: "en",
